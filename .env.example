# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string.
# Local (docker compose up -d): the value below works as is.
# Production (Neon): use the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://eventapp:eventapp@localhost:5432/eventapp?schema=public"

# Optional. Neon only: the direct (unpooled) connection string, used by
# migrations and the seed. Leave unset locally.
# DIRECT_URL=""

# First admin account, created by `npm run db:seed`.
# Use a strong password; the seed hashes it before saving.
SEED_ADMIN_NAME="Event Cell Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"

# ─── Login (Phase 1) ─────────────────────────────────────────────────────────

# Signs the login cookie. Generate one with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# It also signs QR tickets, so changing it makes tickets already issued stop
# scanning. Don't change it in the middle of an event.
AUTH_SECRET=""

# Public address of the app, used in emailed links. Optional on Vercel.
# APP_URL="http://localhost:3000"

# Optional "Sign in with Google". Turns on only when all three are set, and
# then accepts only addresses ending in @ALLOWED_EMAIL_DOMAIN.
# Redirect URI to register in Google Cloud: <APP_URL>/api/auth/callback/google
# ALLOWED_EMAIL_DOMAIN="yourcollege.edu.in"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ─── Email ───────────────────────────────────────────────────────────────────

# Without a key, every email is printed in the terminal running `npm run dev`
# instead of being sent, including its ticket code. The bell works either way.
# RESEND_API_KEY=""
# EMAIL_FROM="CSMSS Events <events@yourcollege.edu.in>"

# ─── Uploads ─────────────────────────────────────────────────────────────────

# cloudinary://<api key>:<api secret>@<cloud name> from the Cloudinary dashboard.
# Without it, development saves uploads in public/uploads/.
# CLOUDINARY_URL=""

# ─── Scheduled jobs ──────────────────────────────────────────────────────────

# Protects the jobs in vercel.json: /api/cron/event-status at midnight India time
# and /api/cron/reminders at 8 am. Vercel sends it automatically once it's set in
# the project. Without it, both jobs answer 401 and no reminders go out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=""

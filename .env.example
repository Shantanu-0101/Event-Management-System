# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string.
# Local (docker compose up -d): the value below works as is.
# Production (Neon): use the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://eventapp:eventapp@localhost:5432/eventapp?schema=public"

# Optional. Neon only: the direct (unpooled) connection string, used by
# migrations and the seed. Leave unset locally.
# DIRECT_URL=""

# First admin account, created by `npm run db:seed`.
# Use a strong password; the seed hashes it before saving.
SEED_ADMIN_NAME="Event Cell Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
